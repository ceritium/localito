<p><%= link_to "← Back", root_path(q: @query) %></p>
<h1><%= @locale %>.<%= @name %></h1>
<p class="root"><%= @translations.relative(@entry.path) %>:<%= @entry.line %></p>

<% unless @error.empty? %>
  <p class="error"><%= @error %></p>
<% end %>

<div id="live" data-version="<%= @version %>" data-mode="edit">
  <div data-disk-value="<%= @entry.value %>"></div>
</div>
<div id="disk-change" class="error" hidden>
  Changed on disk while you edit:
  <pre></pre>
  <%= link_to "Reload", edit_translation_path(name: @name, locale: @locale, q: @query) %>
</div>

<%= form_with url: translation_path, method: :patch do |f| %>
  <input type="hidden" name="name" value="<%= @name %>">
  <input type="hidden" name="locale" value="<%= @locale %>">
  <input type="hidden" name="q" value="<%= @query %>">
  <input type="hidden" name="original" value="<%= @original %>">
  <textarea name="value" rows="4" autofocus><%= @value %></textarea>
  <button>Save</button>
<% end %>
