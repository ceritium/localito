<p><%= link_to "← Back", root_path(q: @query) %></p>
<h1><%= @locale %>.<%= @name %></h1>
<p class="root"><%= @translations.relative(@entry.path) %>:<%= @entry.line %></p>

<% unless @error.empty? %>
  <p class="error"><%= @error %></p>
<% end %>

<%= form_with url: translation_path, method: :patch do |f| %>
  <input type="hidden" name="name" value="<%= @name %>">
  <input type="hidden" name="locale" value="<%= @locale %>">
  <input type="hidden" name="q" value="<%= @query %>">
  <textarea name="value" rows="4" autofocus><%= @value %></textarea>
  <button>Save</button>
<% end %>
