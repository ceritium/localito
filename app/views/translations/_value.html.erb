<% entry = t.cell(name, locale) %>
<% kind = t.change(name, locale) %>
<div class="cell <%= kind %><%= entry.nil? ? " is-missing" : "" %>" data-cell="<%= locale %>.<%= name %>" data-name="<%= name %>" data-locale="<%= locale %>" data-original="<%= entry ? entry.value : "" %>" data-missing="<%= entry ? "0" : "1" %>" data-editable="<%= entry.nil? || entry.editable ? "1" : "0" %>">
  <% if kind == "modified" || kind == "removed" %>
    <div class="base" title="At the base"><%= t.base_value(name, locale) %></div>
  <% end %>
  <% if entry.nil? %>
    <div class="missing">missing</div>
  <% elsif entry.value.empty? %>
    <div class="now blank">empty</div>
  <% else %>
    <div class="now<%= entry.editable ? "" : " readonly" %>"><%= entry.value %></div>
  <% end %>
</div>
