<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <title><%= content_for?(:title) ? yield(:title) : "Localito" %></title>
  <%= stylesheet_link_tag "style" %>
  <script>try { if (localStorage.getItem("localito.files") === "hidden") document.documentElement.classList.add("files-collapsed"); } catch (e) {}</script>
  <%= javascript_include_tag "live", defer: true %>
</head>
<body>
  <% if notice %><p class="notice"><%= notice %></p><% end %>
  <% if alert %><p class="alert"><%= alert %></p><% end %>
  <%= yield %>
</body>
</html>
