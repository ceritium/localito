#!/usr/bin/env bash
# localito web [DIR] [-c CONFIG] [-p PORT] [--no-open]   browse and edit DIR's locale files
# localito init [DIR] [-c CONFIG]                        write the default config
# localito grep [DIR] [-k KEY] [-v VALUE]                search the locale files
set -euo pipefail

self=$(readlink -f "$0" 2>/dev/null || echo "$0")
app=$(cd "$(dirname "$self")/.." && pwd)
# A release has the server in libexec/; a checkout builds it in place.
if [ -x "$app/libexec/localito-server" ]; then
  server="$app/libexec/localito-server"
  logdir="${XDG_STATE_HOME:-$HOME/.local/state}/localito"
else
  server="$app/localito"
  logdir="$app/log"
fi

usage() {
  cat <<'USAGE'
Usage:
  localito web [DIR] [options]    browse and edit DIR's locale files (default: .)
  localito init [DIR] [options]   write DIR/.localito.yml with every setting
  localito grep [DIR] [options]   search the locale files from the terminal

web options:
  -c, --config PATH   config file (default: DIR/.localito.yml)
  -p, --port PORT     first port to try (default: $LOCALITO_PORT or 3900)
      --no-open       don't open the browser
  -h, --help          this help

grep options:
  -k, --key TEXT        only keys that contain TEXT
  -v, --value TEXT      only values that contain TEXT
  -l, --locale CODES    only these locales, comma-separated (en,es)
  -s, --case-sensitive  don't ignore case
      --changed         only entries that changed since --base
      --base REF        git ref to compare with (default: from the config)
      --no-color        plain output, no escape codes

grep without -k or -v lists every entry; exit code 1 when nothing matched.

The server log goes to localito.log in ~/.local/state/localito (log/ in a
checkout).
USAGE
}

command=""
case "${1:-}" in
  web) command="web"; shift ;;
  init) command="init"; shift ;;
  grep) command="grep"; shift ;;
  help|-h|--help) usage; exit 0 ;;
  "") usage >&2; exit 2 ;;
  -*) echo "localito: unknown option: $1" >&2; usage >&2; exit 2 ;;
  *) echo "localito: unknown command: $1" >&2; usage >&2; exit 2 ;;
esac

root="."
config=""
port="${LOCALITO_PORT:-3900}"
open_browser=1
root_set=0
if [ "$command" = "grep" ]; then
  args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -c|--config) config="${2:?--config needs a path}"; shift 2 ;;
      --config=*) config="${1#*=}"; shift ;;
      -h|--help) usage; exit 0 ;;
      -k|--key|-v|--value|-l|--locale|--base)
        [ $# -ge 2 ] || { echo "localito: $1 needs a value" >&2; exit 2; }
        args+=("$1" "$2"); shift 2 ;;
      --key=*|--value=*|--locale=*|--base=*) args+=("$1"); shift ;;
      -s|--case-sensitive|--changed|--no-color) args+=("$1"); shift ;;
      -*) echo "localito: unknown option $1" >&2; usage >&2; exit 2 ;;
      *)
        [ $root_set -eq 0 ] || { echo "localito: one directory at a time" >&2; exit 2; }
        root="$1"; root_set=1; shift ;;
    esac
  done
else
  while [ $# -gt 0 ]; do
    case "$1" in
      -c|--config) config="${2:?--config needs a path}"; shift 2 ;;
      --config=*) config="${1#*=}"; shift ;;
      -p|--port) port="${2:?--port needs a number}"; shift 2 ;;
      --port=*) port="${1#*=}"; shift ;;
      --no-open) open_browser=0; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) echo "localito: unknown option $1" >&2; usage >&2; exit 2 ;;
      *)
        [ $root_set -eq 0 ] || { echo "localito: one directory at a time" >&2; exit 2; }
        root="$1"; root_set=1; shift ;;
    esac
  done
fi

given="$root"
root=$(cd "$root" 2>/dev/null && pwd) || { echo "localito: no such directory: $given" >&2; exit 1; }
if [ -n "$config" ]; then
  config=$(cd "$(dirname "$config")" 2>/dev/null && echo "$(pwd)/$(basename "$config")") \
    || { echo "localito: no such directory for $config" >&2; exit 1; }
fi

if [ "$command" = "init" ]; then
  target="${config:-$root/.localito.yml}"
  if [ -e "$target" ]; then
    echo "localito: $target already exists" >&2
    exit 1
  fi
  cat > "$target" <<'YAML'
# localito settings; every key is optional and shown with its default.

# Locale files to load, as globs relative to the app's root, e.g.
# "config/locales/**/*.yml". Empty: every .yml or .yaml file whose top-level
# key is a locale (en:, pt-BR:), outside hidden folders, node_modules, vendor,
# tmp, log, public, coverage and storage.
paths: []

# Globs (relative to the root) to leave out, e.g. vendored locales.
exclude: []

# Globs of files that are shown but never written.
readonly: []

# Column order; locales not listed follow, sorted. Empty: all, sorted.
locales: []

# The reference locale: first column, and what placeholders (%{count}) and
# XLIFF exports are checked against. Empty: the first locale.
default_locale: ""

# Git ref the working tree is compared with.
base: HEAD

# Where a new key goes when no file of its locale shares a prefix with it.
new_keys: "config/locales/%{locale}.yml"
YAML
  echo "localito: wrote $target"
  exit 0
fi

if [ -n "$config" ] && [ ! -f "$config" ]; then
  echo "localito: no such config: $config (localito init -c $config writes one)" >&2
  exit 1
fi

[ -x "$server" ] || (cd "$app" && bin/spinrail build)

if [ "$command" = "grep" ]; then
  set +e
  (cd "$root" && LOCALITO_ROOT="$root" LOCALITO_CONFIG="$config" "$server" grep ${args[@]+"${args[@]}"})
  exit $?
fi

while nc -z localhost "$port" 2>/dev/null; do port=$((port + 1)); done
mkdir -p "$logdir"
log="$logdir/localito.log"

echo "localito: $root on http://localhost:$port (Ctrl+C to stop)"
[ -n "$config" ] && echo "localito: config $config"
if [ $open_browser -eq 1 ]; then
  opener=$(command -v open || command -v xdg-open || true)
  [ -n "$opener" ] && (sleep 1 && "$opener" "http://localhost:$port" >/dev/null 2>&1) &
fi

set +e
(cd "$logdir" && LOCALITO_ROOT="$root" LOCALITO_CONFIG="$config" "$server" -p "$port" >> "$log" 2>&1)
code=$?
set -e
if [ $code -ne 0 ] && [ $code -ne 130 ]; then
  echo "localito: server exited with $code; last lines of $log:" >&2
  tail -n 15 "$log" >&2
fi
exit $code
