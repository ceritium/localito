#!/usr/bin/env ruby
# bin/release-meta VERSION SHA256SUMS formula|nix: the Homebrew formula or
# nix/release.json for a release, from the archives' checksums.
require "json"

tag, sums_file, kind = ARGV
abort "usage: bin/release-meta VERSION SHA256SUMS formula|nix" unless tag && sums_file && %w[formula nix].include?(kind)
version = tag.delete_prefix("v")
sums = File.readlines(sums_file).to_h do |line|
  sum, file = line.split
  [file[/-(\w+-\w+)\.tar\.gz\z/, 1], sum]
end
platforms = %w[macos-arm64 linux-arm64 linux-x86_64]
missing = platforms - sums.keys
abort "release-meta: no checksum for #{missing.join(', ')}" unless missing.empty?

if kind == "nix"
  puts JSON.pretty_generate("version" => version, "sha256" => sums.slice(*platforms.sort))
  exit
end

url = ->(platform) { "https://github.com/ceritium/localito/releases/download/v#{version}/localito-v#{version}-#{platform}.tar.gz" }
asset = ->(platform, indent) { %(#{indent}url "#{url.(platform)}"\n#{indent}sha256 "#{sums[platform]}") }
puts <<~RUBY
  # Generated by localito's release workflow; edits are overwritten.
  class Localito < Formula
    desc "Browse and edit a Rails app's i18n YAML files in the browser"
    homepage "https://github.com/ceritium/localito"

    on_macos do
      depends_on arch: :arm64
      depends_on "openssl@3"
  #{asset.("macos-arm64", "    ")}
    end

    on_linux do
      on_arm do
  #{asset.("linux-arm64", "      ")}
      end
      on_intel do
  #{asset.("linux-x86_64", "      ")}
      end
    end

    def install
      libexec.install Dir["*"]
      bin.install_symlink libexec/"bin/localito"
    end

    test do
      assert_match "Usage:", shell_output("\#{bin}/localito --help")
    end
  end
RUBY
